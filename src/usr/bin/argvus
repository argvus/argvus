#!/usr/bin/env sh
# Argvus command dispatcher.

VERSION="0.1.0"

set -eu

usage() {
  cat <<'EOF'
Usage:
  argvus --start-desktop
  argvus --setup [setup options]
  argvus --system-monitor [btop options]
  argvus --control-center [page]
  argvus --terminal [terminal options]
  argvus --spf [superfile options]
  argvus --yazi [yazi options]
  argvus --about [about tab]
  argvus --calendar [argvus taskbar-calendar options]
  argvus --game-snake
  argvus --default-apps [control center Apps options]
  argvus --removable-devices [argvus removable-devices options]
  argvus --displays [control center Displays page]
  argvus --network-interfaces
  argvus --version
  argvus help | --help | -h
  argvus <command> [arguments...]

Commands:
  argvus sessionctl | session | start | tty
  argvus greeter | greeter-session | greeter-tui | greeter-setup
  argvus config | i18n | accounts | firewall
  argvus taskbar-calendar | removable-devices | notifications
  argvus networkctl | bluetoothctl | displayctl | widget-telemetry-toggle
  argvus launcher | projects | snippets | ssh | git
  argvus tui-terminal | app-profiles-yazi-keymap | game-snake | terminal

Aliases:
  argvus setup | system-monitor | control-center | terminal | spf | yazi | about | calendar | game-snake | default-apps | removable-devices | displays | version

Setup options:
  --copy <app>   Copy /usr/share/argvus/<app> to ~/.config/argvus/data/<app>.
  --copy-all     Copy all packaged defaults for explicit customization.
  --force        Replace an existing destination after backing it up.
  --repair       Backward-compatible alias for --copy argvus.
  --dry-run      Print actions without changing files.
EOF
}

die() { printf 'argvus: %s\n' "$*" >&2; exit 1; }

# Directory of private executables. Packages install them here instead of
# /usr/bin; ARGVUS_COMMANDS_DIR lets tests and DESTDIR checks override it.
ARGVUS_COMMANDS_DIR="${ARGVUS_COMMANDS_DIR:-/usr/lib/argvus/commands}"

# Maps a public subcommand to its private executable name. Only the names
# listed here can be reached through the generic dispatch, so user input is
# never used to build a path. `argvus` itself is never listed.
private_command_name() {
  case "$1" in
    session) printf 'argvus-session\n' ;;
    start) printf 'argvus-start\n' ;;
    tty) printf 'argvus-tty\n' ;;
    sessionctl) printf 'argvus-sessionctl\n' ;;
    greeter) printf 'argvus-greeter\n' ;;
    greeter-session) printf 'argvus-greeter-session\n' ;;
    greeter-tui) printf 'argvus-greeter-tui\n' ;;
    greeter-setup) printf 'argvus-greeter-setup\n' ;;
    config) printf 'argvus-config\n' ;;
    i18n) printf 'argvus-i18n\n' ;;
    accounts) printf 'argvus-accounts\n' ;;
    firewall) printf 'argvus-firewall\n' ;;
    taskbar-calendar) printf 'argvus-taskbar-calendar\n' ;;
    removable-devices) printf 'argvus-removable-devices\n' ;;
    notifications) printf 'argvus-notifications\n' ;;
    networkctl) printf 'argvus-networkctl\n' ;;
    bluetoothctl) printf 'argvus-bluetoothctl\n' ;;
    displayctl) printf 'argvus-displayctl\n' ;;
    widget-telemetry-toggle) printf 'argvus-widget-telemetry-toggle\n' ;;
    launcher) printf 'argvus-launcher\n' ;;
    projects) printf 'argvus-projects\n' ;;
    snippets) printf 'argvus-snippets\n' ;;
    ssh) printf 'argvus-ssh\n' ;;
    git) printf 'argvus-git\n' ;;
    tui-terminal) printf 'argvus-tui-terminal\n' ;;
    app-profiles-yazi-keymap) printf 'argvus-app-profiles-yazi-keymap\n' ;;
    game-snake) printf 'argvus-game-snake\n' ;;
    terminal) printf 'argvus-terminal\n' ;;
    *) return 1 ;;
  esac
}

# Prints the executable for a private name. The commands directory wins. The
# PATH fallback covers packages that still install the file in /usr/bin; it
# only runs for names already accepted by private_command_name.
resolve_private_command() {
  if [ -x "$ARGVUS_COMMANDS_DIR/$1" ]; then
    printf '%s\n' "$ARGVUS_COMMANDS_DIR/$1"
    return 0
  fi
  command -v "$1" 2>/dev/null
}

# Prints the private executable for a name, or stops with an error.
private_path() {
  _path="$(resolve_private_command "$1")" || die "$1 is not installed"
  printf '%s\n' "$_path"
}

# Replaces this process with the private command, forwarding every argument
# unchanged. Stdin, stdout, stderr, signals and the exit status are inherited.
dispatch_private() {
  _sub="$1"
  shift
  _name="$(private_command_name "$_sub")" \
    || die "unknown command: $_sub (see 'argvus --help')"
  _path="$(resolve_private_command "$_name")" \
    || die "$_name is not installed"
  exec "$_path" "$@"
}

require_command() {
  _command="$1"
  command -v "$_command" >/dev/null 2>&1 || die "$_command is not installed"
}

source_bootstrap() {
  : "${HOME:?HOME is not set}"
  ARGVUS_BOOTSTRAP="${ARGVUS_BOOTSTRAP:-${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}/session/sh/bootstrap.sh}"
  # shellcheck disable=SC1090
  . "$ARGVUS_BOOTSTRAP"
}

has_arg() {
  _patterns="$1"
  shift
  for _arg do
    for _pattern in $_patterns; do
      # shellcheck disable=SC2254
      case "$_arg" in
        $_pattern) return 0 ;;
      esac
    done
  done
  return 1
}

run_setup() {
  CONFIG_SRC="${ARGVUS_CONFIG_SRC:-/usr/share/argvus}"
  CONFIG_DST="${ARGVUS_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}/argvus"
  dry_run=false
  force=false
  copy_all=false
  copy_items=""

  log() { printf '%s\n' "$*"; }
  setup_die() { printf 'argvus --setup: %s\n' "$*" >&2; exit 1; }

  run() {
    if [ "$dry_run" = true ]; then
      printf '[dry-run] %s\n' "$*"
    else
      "$@"
    fi
  }

  append_copy_item() {
    item="$1"
    case "$item" in
      ''|.*|*/*) setup_die "invalid app name: $item" ;;
    esac
    copy_items="${copy_items}${copy_items:+ }$item"
  }

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --copy)
        [ "$#" -ge 2 ] || setup_die "--copy requires an app name."
        append_copy_item "$2"
        shift
        ;;
      --copy=*)
        append_copy_item "${1#--copy=}"
        ;;
      --copy-all)
        copy_all=true
        ;;
      --force)
        force=true
        ;;
      --repair)
        append_copy_item argvus
        ;;
      --dry-run)
        dry_run=true
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        setup_die "unknown option: $1"
        ;;
    esac
    shift
  done

  [ -n "${HOME:-}" ] || setup_die "HOME is not set."
  [ -d "$CONFIG_SRC" ] || setup_die "config source not found: $CONFIG_SRC"

  if [ "$copy_all" = false ] && [ -z "$copy_items" ]; then
    usage
    exit 0
  fi

  if [ "$copy_all" = true ]; then
    copy_items=""
    for src_dir in "$CONFIG_SRC"/*; do
      [ -d "$src_dir" ] || continue
      copy_items="${copy_items}${copy_items:+ }${src_dir##*/}"
    done
  fi

  timestamp="$(date +%Y%m%d%H%M%S)"
  run mkdir -p "$CONFIG_DST"

  copy_app() {
    app="$1"
    src="$CONFIG_SRC/$app"

    [ -d "$src" ] || setup_die "packaged config not found for app '$app': $src"

    if [ "$app" = "argvus" ]; then
      dst="$CONFIG_DST"
      copy_src="$src/."
    else
      dst="$CONFIG_DST/$app"
      copy_src="$src"
    fi

    if [ -e "$dst" ] || [ -L "$dst" ]; then
      if [ "$force" != true ]; then
        setup_die "destination already exists: $dst
Use --force to replace it after a backup."
      fi

      backup="${dst}.bak-${timestamp}"
      suffix=1
      while [ -e "$backup" ] || [ -L "$backup" ]; do
        backup="${dst}.bak-${timestamp}-${suffix}"
        suffix=$((suffix + 1))
      done
      run mv "$dst" "$backup"
      log "Backup: $dst -> $backup"
    fi

    run mkdir -p "$(dirname "$dst")"
    run cp -R "$copy_src" "$dst"
    log "Copied: $src -> $dst"
  }

  for app in $copy_items; do
    copy_app "$app"
  done

  log "Done. Copied files are now user overrides."
}

run_system_monitor() {
  _system_monitor="$(private_path argvus-system-monitor)"
  exec "$_system_monitor" "$@"
}

run_terminal() {
  _terminal="$(private_path argvus-terminal)"
  exec "$_terminal" "$@"
}

find_control_center() {
  private_path argvus-control-center
}

run_control_center() {
  _control_center="$(find_control_center)"
  _tui_terminal="$(private_path argvus-tui-terminal)"
  case "${1:-}" in
    --apps) shift; set -- apps "$@" ;;
    --fonts) shift; set -- fonts "$@" ;;
    --locale) shift; set -- locale "$@" ;;
    --language) shift; set -- language "$@" ;;
    --system) shift; set -- system "$@" ;;
    --about) shift; set -- about "$@" ;;
    --displays|--monitors) shift; set -- displays "$@" ;;
    --timezone|--date-time|--regional-locale|--system-locales|--encoding|--keyboard|--keyboard-layout|--keyboard-variant|--console-keymap)
      set -- locale "$@"
      ;;
    --hostname|--firewall|--users|--groups)
      set -- system "$@"
      ;;
  esac

  # Keep the Control Center single-instance.  The class is assigned by
  # argvus-tui-terminal.  Some terminal backends expose their own class
  # (currently kitty), so retain the title fallback for the same TUI window.
  # Focusing by address also switches to its workspace in Hyprland.
  if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    _control_center_address="$(hyprctl clients -j 2>/dev/null \
      | jq -r 'map(select(.class == "argvus-control-center" or .initialClass == "argvus-control-center" or (.class == "kitty" and ((.title // "") | test("argvus-control-center$")))))[0].address // empty' 2>/dev/null || true)"
    if [ -n "$_control_center_address" ]; then
      hyprctl eval "hl.dispatch(hl.dsp.focus({ window = \"address:$_control_center_address\" }))" >/dev/null 2>&1 || true
      return 0
    fi
  fi

  # Serialize the check-and-start window.  This also handles two key presses
  # arriving before Hyprland reports the newly created client.
  _control_center_lock="${XDG_RUNTIME_DIR:-/tmp}/argvus-control-center.lock"
  exec 9>"$_control_center_lock"
  if ! flock -n 9; then
    return 0
  fi

  # Recheck after acquiring the lock: another invocation may have started the
  # terminal while this one was waiting for the lock.
  if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    _control_center_address="$(hyprctl clients -j 2>/dev/null \
      | jq -r 'map(select(.class == "argvus-control-center" or .initialClass == "argvus-control-center" or (.class == "kitty" and ((.title // "") | test("argvus-control-center$")))))[0].address // empty' 2>/dev/null || true)"
    if [ -n "$_control_center_address" ]; then
      hyprctl eval "hl.dispatch(hl.dsp.focus({ window = \"address:$_control_center_address\" }))" >/dev/null 2>&1 || true
      flock -u 9
      return 0
    fi
  fi

  env ARGVUS_ICON_SCALE=3/3 "$_tui_terminal" --class argvus-control-center --term kitty --profile control-center -- "$_control_center" "$@" &
  _control_center_pid=$!

  # Wait briefly for the client to be registered before releasing the lock.
  # This closes the race without keeping a lock for the lifetime of the app.
  if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    _control_center_attempt=0
    while [ "$_control_center_attempt" -lt 20 ]; do
      _control_center_address="$(hyprctl clients -j 2>/dev/null \
        | jq -r 'map(select(.class == "argvus-control-center" or .initialClass == "argvus-control-center" or (.class == "kitty" and ((.title // "") | test("argvus-control-center$")))))[0].address // empty' 2>/dev/null || true)"
      [ -n "$_control_center_address" ] && break
      kill -0 "$_control_center_pid" 2>/dev/null || break
      sleep 0.1
      _control_center_attempt=$((_control_center_attempt + 1))
    done
  fi
  # Do not report success when the terminal wrapper failed before registering
  # a Hyprland client. This makes shortcut and desktop-entry failures visible
  # instead of silently leaving the user with no window.
  if ! kill -0 "$_control_center_pid" 2>/dev/null; then
    if wait "$_control_center_pid"; then
      :
    else
      _control_center_status=$?
      flock -u 9
      return "$_control_center_status"
    fi
  fi
  flock -u 9
}

run_spf() {
  _terminal_term="${TERM-}"
  source_bootstrap
  if [ -n "$_terminal_term" ]; then
    TERM="$_terminal_term"
    export TERM
  fi
  if has_arg '-c --config-file --config-file=* --hf --hotkey-file --hotkey-file=*' "$@"; then
    exec spf "$@"
  fi
  _native_dir="${ARGVUS_CONFIG_HOME}/superfile"
  if [ -e "$_native_dir" ] || [ -L "$_native_dir" ]; then
    XDG_CONFIG_HOME="$ARGVUS_CONFIG_HOME"
    export XDG_CONFIG_HOME
    exec spf "$@"
  fi
  _argvus_superfile_dir="$(paths_config app-profiles/config/superfile)"
  XDG_CONFIG_HOME="${_argvus_superfile_dir%/superfile}"
  export XDG_CONFIG_HOME
  exec spf "$@"
}

resolve_argvus_yazi_config() {
  for _dir in "$(paths_user_config app-profiles/config/yazi)" "$(paths_generated_config app-profiles/config/yazi)" "$(paths_system_config app-profiles/config/yazi)"; do
    if [ -e "$_dir" ] || [ -L "$_dir" ]; then
      printf '%s\n' "$_dir"
      return 0
    fi
  done
  paths_system_config app-profiles/config/yazi
}

read_active_theme() {
  _active_file="${ARGVUS_CONFIG_HOME}/argvus/data/.active-theme"
  if [ -f "$_active_file" ]; then
    sed -n '1p' "$_active_file"
  else
    printf 'argvus-dark\n'
  fi
}

materialize_argvus_yazi_config() {
  _theme="$(read_active_theme)"
  _dst="$(paths_user_config app-profiles/config/yazi)"
  _src="$(paths_system_config app-profiles/config/yazi)"

  if [ ! -d "$_dst" ] && [ -d "$_src" ]; then
    mkdir -p "$_dst"
    cp -R "$_src/." "$_dst/"
  elif [ -d "$_src" ]; then
    mkdir -p "$_dst"
    for _item in package.toml keymap.toml; do
      if [ -f "$_src/$_item" ] && [ ! -e "$_dst/$_item" ]; then
        cp "$_src/$_item" "$_dst/$_item"
      fi
    done
    if [ -d "$_src/flavors" ]; then
      mkdir -p "$_dst/flavors"
      for _flavor in "$_src"/flavors/*.yazi; do
        [ -d "$_flavor" ] || continue
        _flavor_dst="$_dst/flavors/${_flavor##*/}"
        [ -e "$_flavor_dst" ] || cp -R "$_flavor" "$_flavor_dst"
      done
    fi
    if [ -d "$_src/flavors/${_theme}.yazi" ]; then
      mkdir -p "$_dst/flavors/${_theme}.yazi"
      cp -R "$_src/flavors/${_theme}.yazi/." "$_dst/flavors/${_theme}.yazi/"
    fi
  fi

  if [ -f "$_dst/flavors/${_theme}.yazi/flavor.toml" ]; then
    printf '[flavor]\ndark = "%s"\n' "$_theme" > "$_dst/theme.toml"
    printf '%s\n' "$_dst"
  else
    resolve_argvus_yazi_config
  fi
}

run_yazi() {
  _requested_yazi_config="${YAZI_CONFIG_HOME:-}"
  _terminal_term="${TERM-}"
  source_bootstrap
  if [ -n "$_terminal_term" ]; then
    TERM="$_terminal_term"
    export TERM
  fi
  if [ -n "$_requested_yazi_config" ] && [ -d "$_requested_yazi_config" ]; then
    case "$_requested_yazi_config" in
      "${ARGVUS_CONFIG_HOME}/argvus/data/yazi"|/usr/share/argvus/yazi) ;;
      *) exec yazi "$@" ;;
    esac
  fi
  _native_dir="${ARGVUS_CONFIG_HOME}/yazi"
  if [ -e "$_native_dir" ] || [ -L "$_native_dir" ]; then
    _native_theme="$_native_dir/theme.toml"
    _native_flavor=""
    if [ -f "$_native_theme" ]; then
      _native_flavor="$(sed -n 's/^[[:space:]]*dark[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$_native_theme" | head -n1)"
    fi
    case "$_native_flavor" in
      argvus-*)
        if [ ! -f "$_native_dir/flavors/${_native_flavor}.yazi/flavor.toml" ]; then
          YAZI_CONFIG_HOME="$(materialize_argvus_yazi_config)"
          export YAZI_CONFIG_HOME
          exec yazi "$@"
        fi
        ;;
    esac
    YAZI_CONFIG_HOME="$_native_dir"
    export YAZI_CONFIG_HOME
    exec yazi "$@"
  fi
  YAZI_CONFIG_HOME="$(materialize_argvus_yazi_config)"
  export YAZI_CONFIG_HOME
  exec yazi "$@"
}

run_about() {
  run_control_center --about "$@"
}

run_calendar() {
  if [ "$#" -eq 0 ]; then
    set -- toggle
  fi
  _calendar="$(private_path argvus-taskbar-calendar)"
  exec "$_calendar" "$@"
}

run_game_snake() {
  _game_snake="$(private_path argvus-game-snake)"
  if [ -t 0 ] && [ -t 1 ]; then
    exec "$_game_snake" "$@"
  fi
  _tui_terminal="$(private_path argvus-tui-terminal)"
  exec "$_tui_terminal" \
    --class argvus-game-snake \
    --term kitty \
    --profile control-center \
    -- "$_game_snake" "$@"
}

run_default_apps() {
  run_control_center apps "$@"
}

run_removable_devices() {
  if [ "$#" -eq 0 ]; then
    set -- menu
  fi
  _removable="$(private_path argvus-removable-devices)"
  exec "$_removable" "$@"
}

case "${1:-}" in
  --start-desktop)
    # argvus-tty comes from the "argvus-session" package.
    dispatch_private tty
    ;;
  --setup|setup)
    shift
    run_setup "$@"
    ;;
  --system-monitor|system-monitor)
    shift
    run_system_monitor "$@"
    ;;
  --control-center|control-center)
    shift
    run_control_center "$@"
    ;;
  --terminal|terminal)
    shift
    run_terminal "$@"
    ;;
  --spf|spf|--superfile|superfile)
    shift
    run_spf "$@"
    ;;
  --yazy|yazy|--yazi|yazi)
    shift
    run_yazi "$@"
    ;;
  --about|about)
    shift
    run_about "$@"
    ;;
  --calendar|calendar)
    shift
    run_calendar "$@"
    ;;
  --game-snake|game-snake)
    shift
    run_game_snake "$@"
    ;;
  --default-apps|default-apps)
    shift
    run_default_apps "$@"
    ;;
  --removable-devices|removable-devices|--storage|storage)
    shift
    run_removable_devices "$@"
    ;;
  --displays|displays)
    shift
    run_control_center displays "$@"
    ;;
  --network-interfaces)
    shift
    run_control_center network interfaces "$@"
  ;;
  --version|-V|version)
    printf 'ARGVUS %s\n' "$VERSION"
    ;;
  --help|-h|help|'')
    usage
    ;;
  *)
    _command="$1"
    shift
    dispatch_private "$_command" "$@"
    ;;
esac
