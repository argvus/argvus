#!/usr/bin/env sh

set -eu

# Argvus Waybar passes coordinates from the original button event relative to
# its layer surface. Add the layer's stable origin to obtain desktop
# coordinates without ever reading the moving pointer.
position=""
if [ "${1:-}" = "--root" ] && [ "$#" -ge 3 ]; then
	root_x="$(printf '%s\n' "$2" | sed -n '/^-\{0,1\}[0-9][0-9]*$/p')"
	root_y="$(printf '%s\n' "$3" | sed -n '/^-\{0,1\}[0-9][0-9]*$/p')"
	if [ -n "$root_x" ] && [ -n "$root_y" ]; then
		position="{\"x\":$root_x,\"y\":$root_y}"
	fi
elif [ "${1:-}" = "--surface" ] && [ "$#" -ge 3 ] && command -v jq >/dev/null 2>&1; then
	surface_x="$(printf '%s\n' "$2" | sed -n '/^-\{0,1\}[0-9][0-9]*$/p')"
	surface_y="$(printf '%s\n' "$3" | sed -n '/^-\{0,1\}[0-9][0-9]*$/p')"
	origin="$(
		hyprctl layers -j 2>/dev/null |
			jq -r --arg output "${WAYBAR_OUTPUT_NAME:-}" '
				[
					to_entries[]
					| select($output == "" or .key == $output)
					| .value.levels
					| to_entries[].value[]
					| select((.namespace == "argvus-taskbar" or .namespace == "waybar") and .w > (.h * 4))
					| [.x, .y, .w, .h]
				]
				| first // empty
				| @tsv
			' 2>/dev/null ||
			true
	)"
	origin_x="$(printf '%s\n' "$origin" | cut -f1)"
	origin_y="$(printf '%s\n' "$origin" | cut -f2)"
	bar_width="$(printf '%s\n' "$origin" | cut -f3)"
	bar_height="$(printf '%s\n' "$origin" | cut -f4)"
	origin_x="$(printf '%s\n' "$origin_x" | sed -n '/^-\{0,1\}[0-9][0-9]*$/p')"
	origin_y="$(printf '%s\n' "$origin_y" | sed -n '/^-\{0,1\}[0-9][0-9]*$/p')"
	bar_width="$(printf '%s\n' "$bar_width" | sed -n '/^-\{0,1\}[0-9][0-9]*$/p')"
	bar_height="$(printf '%s\n' "$bar_height" | sed -n '/^-\{0,1\}[0-9][0-9]*$/p')"

	if [ -n "$surface_x" ] && [ -n "$surface_y" ] && [ -n "$origin_x" ] && [ -n "$origin_y" ] && [ -n "$bar_width" ] && [ -n "$bar_height" ]; then
		position="{\"x\":$((origin_x + surface_x)),\"y\":$((origin_y + surface_y)),\"bar_bottom\":$((origin_y + bar_height)),\"bar_right\":$((origin_x + bar_width))}"
	fi
fi

# Compatibility fallback for Waybar versions without event-coordinate support.
if [ -z "$position" ]; then
	position="$(hyprctl cursorpos -j 2>/dev/null || true)"
fi

x="$(printf '%s' "$position" | sed -n 's/.*"x": *\(-\{0,1\}[0-9][0-9]*\).*/\1/p' || true)"
y="$(printf '%s' "$position" | sed -n 's/.*"y": *\(-\{0,1\}[0-9][0-9]*\).*/\1/p' || true)"

if [ -n "$x" ] && [ -n "$y" ]; then
	bar_bottom="$(printf '%s' "$position" | sed -n 's/.*"bar_bottom": *\(-\{0,1\}[0-9][0-9]*\).*/\1/p' || true)"
	bar_right="$(printf '%s' "$position" | sed -n 's/.*"bar_right": *\(-\{0,1\}[0-9][0-9]*\).*/\1/p' || true)"
	if [ -n "$bar_bottom" ] && [ -n "$bar_right" ]; then
		exec argvus taskbar-calendar toggle --x "$x" --y "$y" --bar-bottom "$bar_bottom" --bar-right "$bar_right"
	elif [ -n "$bar_bottom" ]; then
		exec argvus taskbar-calendar toggle --x "$x" --y "$y" --bar-bottom "$bar_bottom"
	fi
	exec argvus taskbar-calendar toggle --x "$x" --y "$y"
fi

exec argvus taskbar-calendar toggle
