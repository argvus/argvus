#!/usr/bin/env sh

set -eu

# The terminal wrapper owns emulator policy (including the Greeter-only Kitty
# profile); the Rust binary remains responsible only for TUI behavior.
# Disable Kitty tabs only for this login surface while preserving the user's
# normal Kitty configuration and active ARGVUS theme.
ARGVUS_COMMANDS_DIR="${ARGVUS_COMMANDS_DIR:-/usr/lib/argvus/commands}"
ARGVUS_BIN="${ARGVUS_BIN:-/usr/bin/argvus}"
[ -x "$ARGVUS_BIN" ] || {
  printf '%s\n' "argvus-greeter-tui: $ARGVUS_BIN is required" >&2
  exit 127
}

"$ARGVUS_BIN" tui-terminal \
  --class argvus-greeter \
  --term kitty \
  --profile greeter \
  -- "$ARGVUS_COMMANDS_DIR/argvus-greeter"
status=$?

exit "$status"
