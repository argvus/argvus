#!/usr/bin/env sh

set -eu

# These paths are package-owned defaults; the backup step below protects an
# administrator's existing greetd configuration before replacement.
SOURCE_CONFIG="/usr/share/doc/argvus-greeter/greetd-config.toml"
TARGET_CONFIG="/etc/greetd/config.toml"
THEME_STATE_DIR="${ARGVUS_GREETER_THEME_STATE_DIR:-/var/lib/argvus/greeter/themes}"
BACKUP_SUFFIX="$(date +%Y%m%d%H%M%S)"
ENABLE=false
START=false
SYNC_THEMES=false
MIGRATE_PATHS=false

usage() {
  cat <<'EOF'
Usage: argvus-greeter-setup [--enable] [--now] [--sync-themes] [--migrate-paths] [--help]

Installs the Argvus greetd configuration at /etc/greetd/config.toml.

Options:
  --enable  enable greetd.service after writing the config
  --now     enable and start greetd.service after writing the config
  --sync-themes  publish existing user themes for the pre-login greeter
  --help    show this help
EOF
}

die() {
  printf 'argvus-greeter-setup: %s\n' "$*" >&2
  exit 1
}

need_root() {
  [ "$(id -u)" -eq 0 ] || die "run as root"
}

while [ "$#" -gt 0 ]; do
  # Parse options explicitly so an unknown operation cannot silently change the
  # active display manager configuration.
  case "$1" in
    --enable)
      ENABLE=true
      shift
    ;;
    --now)
      ENABLE=true
      START=true
      shift
    ;;
    --sync-themes)
      SYNC_THEMES=true
      shift
    ;;
    --migrate-paths)
      MIGRATE_PATHS=true
      shift
    ;;
    -h|--help)
      usage
      exit 0
    ;;
    *)
      die "unknown argument: $1"
    ;;
  esac
done

need_root

is_supported_theme() {
  case "$1" in
    one-dark|one-dark-float|dracula|dracula-float|argvus-dark|argvus-dark-float|silver-dark|silver-dark-float|\
    slate-dark|slate-dark-float|universe|universe-float|\
    argvus-light|argvus-light-float|github-light|github-light-float|solarized-light|solarized-light-float|one-light|one-light-float|everforest-light|everforest-light-float|frost|frost-float|catppuccin-latte|catppuccin-latte-float|gruvbox-light|gruvbox-light-float|rose-pine|rose-pine-float|tokyo-night|tokyo-night-float|solitude|solitude-float|sunset|sunset-float|matrix|matrix-float|monokai-dark|monokai-dark-float)
      return 0
      ;;
    *)
      # Drop-in themes are supported when their installed manifest exists.
      [ -r "${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}/appearance/themes.d/$1/theme.toml" ] && return 0
      return 1
      ;;
  esac
}

canonical_theme_id() {
  case "$1" in
    argvus-dark-aether) printf '%s\n' "argvus-dark" ;; argvus-dark-aether-float) printf '%s\n' "argvus-dark-float" ;;
    argvus-light-veil) printf '%s\n' "argvus-light" ;; argvus-light-veil-float) printf '%s\n' "argvus-light-float" ;;
    argvus-onedark) printf '%s\n' "one-dark" ;; argvus-onedark-float) printf '%s\n' "one-dark-float" ;;
    argvus-dark-dracula) printf '%s\n' "dracula" ;; argvus-dark-dracula-float) printf '%s\n' "dracula-float" ;;
    argvus-dark-silver) printf '%s\n' "silver-dark" ;; argvus-dark-silver-float) printf '%s\n' "silver-dark-float" ;;
    argvus-dark-slate) printf '%s\n' "slate-dark" ;; argvus-dark-slate-float) printf '%s\n' "slate-dark-float" ;;
    argvus-dark-universe) printf '%s\n' "universe" ;; argvus-dark-universe-float) printf '%s\n' "universe-float" ;;
    argvus-dark-gruvbox-high) printf '%s\n' "gruvbox-high-dark" ;; argvus-dark-gruvbox-high-float) printf '%s\n' "gruvbox-high-dark-float" ;;
    argvus-dark-gruvbox) printf '%s\n' "gruvbox-dark" ;; argvus-dark-gruvbox-float) printf '%s\n' "gruvbox-dark-float" ;;
    argvus-github-light) printf '%s\n' "github-light" ;; argvus-github-light-float) printf '%s\n' "github-light-float" ;;
    argvus-light-solarized) printf '%s\n' "solarized-light" ;; argvus-light-solarized-float) printf '%s\n' "solarized-light-float" ;;
    argvus-light-frost) printf '%s\n' "frost" ;; argvus-light-frost-float) printf '%s\n' "frost-float" ;;
    argvus-light-gruvbox) printf '%s\n' "gruvbox-light" ;; argvus-light-gruvbox-float) printf '%s\n' "gruvbox-light-float" ;;
    argvus-dark-rose-pine) printf '%s\n' "rose-pine" ;; argvus-dark-rose-pine-float) printf '%s\n' "rose-pine-float" ;;
    argvus-dark-tokio-night) printf '%s\n' "tokyo-night" ;; argvus-dark-tokio-night-float) printf '%s\n' "tokyo-night-float" ;;
    argvus-dark-solitude) printf '%s\n' "solitude" ;; argvus-dark-solitude-float) printf '%s\n' "solitude-float" ;;
    argvus-dark-sunset) printf '%s\n' "sunset" ;; argvus-dark-sunset-float) printf '%s\n' "sunset-float" ;;
    argvus-dark-matrix) printf '%s\n' "matrix" ;; argvus-dark-matrix-float) printf '%s\n' "matrix-float" ;;
    argvus-dark-monokai) printf '%s\n' "monokai-dark" ;; argvus-dark-monokai-float) printf '%s\n' "monokai-dark-float" ;;
    argvus-catppuccin-latte|argvus-light-catppuccin-latte) printf '%s\n' "catppuccin-latte" ;;
    argvus-catppuccin-latte-float|argvus-light-catppuccin-latte-float) printf '%s\n' "catppuccin-latte-float" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

publish_theme_for_user() {
  _uid="$1"
  _gid="$2"
  _theme="$(canonical_theme_id "$3")"
  is_supported_theme "$_theme" || return 0

  _target="$THEME_STATE_DIR/$_uid"
  _tmp="${_target}.tmp.$$"
  if ! printf '%s\n' "$_theme" > "$_tmp"; then
    rm -f -- "$_tmp"
    return 0
  fi
  chmod 0644 "$_tmp"
  chown "$_uid:$_gid" "$_tmp"
  mv -f -- "$_tmp" "$_target"
}

publish_accent_for_user() {
  _uid="$1"
  _gid="$2"
  _home="$3"
  # The managed layout keeps the marker under `data/`. A profile that has not
  # run the migration yet still has it at the root, so accept both.
  _source=''
  for _candidate in \
    "$_home/.config/argvus/data/.accent-color" \
    "$_home/.config/argvus/.accent-color"; do
    if [ -f "$_candidate" ]; then
      _source="$_candidate"
      break
    fi
  done
  _target="$THEME_STATE_DIR/$_uid.accent"

  if [ -z "$_source" ]; then
    rm -f -- "$_target"
    return 0
  fi

  _accent="$(sed -n '1{s/\r$//;s/^[[:space:]]*//;s/[[:space:]]*$//;p;}' "$_source" 2>/dev/null || true)"
  case "$_accent" in
    \#*) _accent="${_accent#\#}" ;;
  esac
  case "$_accent" in
    ??????)
      case "$_accent" in
        *[!0-9A-Fa-f]*) rm -f -- "$_target"; return 0 ;;
      esac
      _accent="#$_accent"
      ;;
    *)
      rm -f -- "$_target"
      return 0
      ;;
  esac

  _tmp="${_target}.tmp.$$"
  if ! printf '%s\n' "$_accent" > "$_tmp"; then
    rm -f -- "$_tmp"
    return 0
  fi
  chmod 0644 "$_tmp"
  chown "$_uid:$_gid" "$_tmp"
  mv -f -- "$_tmp" "$_target"
}

sync_themes() {
  install -d -m 1777 "$THEME_STATE_DIR"

  # Read only the passwd fields needed to locate each interactive user's
  # private source file. Invalid or inaccessible accounts are skipped safely.
  while IFS=: read -r _username _password _uid _gid _gecos _home _shell; do
    [ "${_uid:-0}" -ge 1000 ] 2>/dev/null || continue
    case "${_shell:-}" in
      */false|*/nologin|'') continue ;;
    esac
    [ -n "${_home:-}" ] || continue
    _active=''
    for _candidate in \
      "$_home/.config/argvus/data/.active-theme" \
      "$_home/.config/argvus/.active-theme"; do
      if [ -f "$_candidate" ]; then
        _active="$_candidate"
        break
      fi
    done
    if [ -n "$_active" ]; then
      _theme="$(sed -n '1p' "$_active" 2>/dev/null || true)"
      publish_theme_for_user "$_uid" "$_gid" "$_theme"
    else
      rm -f -- "$THEME_STATE_DIR/$_uid" "$THEME_STATE_DIR/$_uid.tmp"
    fi
    publish_accent_for_user "$_uid" "$_gid" "$_home"
  done < /etc/passwd
}

# Rewrites one exact legacy launch path. The file is backed up first, and any
# other line, including an administrator's own edits, is left unchanged.
migrate_line() {
  _file="$1"
  _old="$2"
  _new="$3"
  [ -f "$_file" ] || return 0
  grep -Fq -- "$_old" "$_file" || return 0
  _backup="${_file}.bak-${BACKUP_SUFFIX}"
  cp -p "$_file" "$_backup"
  _tmp="${_file}.argvus-migrate"
  sed "s|$_old|$_new|g" "$_file" > "$_tmp"
  cat "$_tmp" > "$_file"
  rm -f "$_tmp"
  printf 'Migrated launch path in %s (backup: %s)\n' "$_file" "$_backup"
}

# Moves the greetd and greeter launch paths from the PATH names used before
# commands/ existed to the private commands directory.
migrate_paths() {
  migrate_line "$TARGET_CONFIG" 'command = "argvus-greeter-session"' \
    "command = \"/usr/lib/argvus/commands/argvus-greeter-session\""
  migrate_line "$TARGET_CONFIG" 'command = "argvus-session"' \
    "command = \"/usr/lib/argvus/commands/argvus-session\""
  migrate_line /etc/argvus/hyprland-argvus-greeter.lua \
    '/usr/bin/argvus-greeter-tui' '/usr/lib/argvus/commands/argvus-greeter-tui'
  migrate_line /etc/argvus/hyprland-argvus-greeter.conf \
    '/usr/bin/argvus-greeter-tui' '/usr/lib/argvus/commands/argvus-greeter-tui'
}

if [ "$SYNC_THEMES" = true ]; then
  sync_themes
fi

if [ "$MIGRATE_PATHS" = true ]; then
  need_root
  migrate_paths
  if [ "$ENABLE" != true ]; then
    exit 0
  fi
fi

if [ "$ENABLE" != true ]; then
  [ "$SYNC_THEMES" = true ] && exit 0
fi

[ -f "$SOURCE_CONFIG" ] || die "missing packaged config: $SOURCE_CONFIG"

if [ -f "$TARGET_CONFIG" ] && ! cmp -s "$SOURCE_CONFIG" "$TARGET_CONFIG"; then
  # Timestamped backups make the operation reversible without requiring Git or
  # a package manager database.
  backup="${TARGET_CONFIG}.bak-${BACKUP_SUFFIX}"
  cp "$TARGET_CONFIG" "$backup"
  printf 'Backed up existing greetd config: %s\n' "$backup"
fi

install -Dm644 "$SOURCE_CONFIG" "$TARGET_CONFIG"
printf 'Installed Argvus greetd config: %s\n' "$TARGET_CONFIG"

if [ "$ENABLE" = true ]; then
  systemctl enable greetd.service
fi

if [ "$START" = true ]; then
  systemctl restart greetd.service
fi
