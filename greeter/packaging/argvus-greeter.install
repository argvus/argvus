#!/usr/bin/env bash
# Keep CI-installed package behavior identical to local Arch installations.
post_install() {
  /usr/bin/systemd-tmpfiles --create /usr/lib/tmpfiles.d/argvus-greeter.conf >/dev/null 2>&1 || true
  /usr/lib/argvus/commands/argvus-greeter-setup --migrate-paths >/dev/null 2>&1 || true
  /usr/lib/argvus/commands/argvus-greeter-setup --sync-themes >/dev/null 2>&1 || true
  cat <<'EOF'
==> To use Argvus Greeter with greetd, run:
==>   sudo argvus greeter-setup --enable
==>
==> Use --now instead of --enable to restart greetd.service immediately.
EOF
}

post_upgrade() {
  post_install
}
