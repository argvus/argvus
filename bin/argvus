#!/usr/bin/env sh
# Argvus command dispatcher.

set -eu

usage() {
  cat <<'EOF'
Usage:
  argvus --setup [setup options]
  argvus --btop [btop options]
  argvus --btm [bottom options]
  argvus --spf [superfile options]
  argvus --yazy [yazi options]

Aliases:
  argvus setup | btop | btm | spf | yazi
  argvus --yazi

Setup options:
  --copy <app>   Copy /usr/share/argvus/<app> to ~/.config/argvus/<app>.
  --copy-all     Copy all packaged defaults for explicit customization.
  --force        Replace an existing destination after backing it up.
  --repair       Backward-compatible alias for --copy argvus.
  --dry-run      Print actions without changing files.
EOF
}

die() { printf 'argvus: %s\n' "$*" >&2; exit 1; }

source_bootstrap() {
  : "${HOME:?HOME is not set}"
  ARGVUS_BOOTSTRAP="${ARGVUS_BOOTSTRAP:-${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}/scripts/argvus/bootstrap.sh}"
  # shellcheck disable=SC1090
  . "$ARGVUS_BOOTSTRAP"
}

has_arg() {
  _patterns="$1"
  shift
  for _arg do
    for _pattern in $_patterns; do
      # shellcheck disable=SC2254
      case "$_arg" in
        $_pattern) return 0 ;;
      esac
    done
  done
  return 1
}

run_setup() {
  CONFIG_SRC="${ARGVUS_CONFIG_SRC:-/usr/share/argvus}"
  CONFIG_DST="${ARGVUS_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}/argvus"
  dry_run=false
  force=false
  copy_all=false
  copy_items=""

  log() { printf '%s\n' "$*"; }
  setup_die() { printf 'argvus --setup: %s\n' "$*" >&2; exit 1; }

  run() {
    if [ "$dry_run" = true ]; then
      printf '[dry-run] %s\n' "$*"
    else
      "$@"
    fi
  }

  append_copy_item() {
    item="$1"
    case "$item" in
      ''|.*|*/*) setup_die "invalid app name: $item" ;;
    esac
    copy_items="${copy_items}${copy_items:+ }$item"
  }

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --copy)
        [ "$#" -ge 2 ] || setup_die "--copy requires an app name."
        append_copy_item "$2"
        shift
        ;;
      --copy=*)
        append_copy_item "${1#--copy=}"
        ;;
      --copy-all)
        copy_all=true
        ;;
      --force)
        force=true
        ;;
      --repair)
        append_copy_item argvus
        ;;
      --dry-run)
        dry_run=true
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        setup_die "unknown option: $1"
        ;;
    esac
    shift
  done

  [ -n "${HOME:-}" ] || setup_die "HOME is not set."
  [ -d "$CONFIG_SRC" ] || setup_die "config source not found: $CONFIG_SRC"

  if [ "$copy_all" = false ] && [ -z "$copy_items" ]; then
    usage
    exit 0
  fi

  if [ "$copy_all" = true ]; then
    copy_items=""
    for src_dir in "$CONFIG_SRC"/*; do
      [ -d "$src_dir" ] || continue
      copy_items="${copy_items}${copy_items:+ }${src_dir##*/}"
    done
  fi

  timestamp="$(date +%Y%m%d%H%M%S)"
  run mkdir -p "$CONFIG_DST"

  copy_app() {
    app="$1"
    src="$CONFIG_SRC/$app"

    [ -d "$src" ] || setup_die "packaged config not found for app '$app': $src"

    if [ "$app" = "argvus" ]; then
      dst="$CONFIG_DST"
      copy_src="$src/."
    else
      dst="$CONFIG_DST/$app"
      copy_src="$src"
    fi

    if [ -e "$dst" ] || [ -L "$dst" ]; then
      if [ "$force" != true ]; then
        setup_die "destination already exists: $dst
Use --force to replace it after a backup."
      fi

      backup="${dst}.bak-${timestamp}"
      suffix=1
      while [ -e "$backup" ] || [ -L "$backup" ]; do
        backup="${dst}.bak-${timestamp}-${suffix}"
        suffix=$((suffix + 1))
      done
      run mv "$dst" "$backup"
      log "Backup: $dst -> $backup"
    fi

    run mkdir -p "$(dirname "$dst")"
    run cp -R "$copy_src" "$dst"
    log "Copied: $src -> $dst"
  }

  for app in $copy_items; do
    copy_app "$app"
  done

  log "Done. Copied files are now user overrides."
}

run_btop() {
  source_bootstrap
  if has_arg '-c --config --config=* --themes-dir --themes-dir=*' "$@"; then
    exec btop "$@"
  fi
  _argvus_btop_dir="$(materialize_argvus_btop_config)"
  _native_dir="${ARGVUS_CONFIG_HOME}/btop"
  if [ -e "$_native_dir" ] || [ -L "$_native_dir" ]; then
    _native_conf="$_native_dir/btop.conf"
    if should_manage_btop_config "$_native_conf"; then
      _theme="$(read_active_theme)"
      sed -i "s|color_theme = .*|color_theme = \"${_argvus_btop_dir}/themes/${_theme}/theme.theme\"|" "$_native_conf"
    fi
    XDG_CONFIG_HOME="$ARGVUS_CONFIG_HOME"
    export XDG_CONFIG_HOME
    exec btop "$@"
  fi
  exec btop --config "$_argvus_btop_dir/btop.conf" --themes-dir "$_argvus_btop_dir/themes" "$@"
}

run_btm() {
  source_bootstrap
  if has_arg '-C --config_location --config_location=*' "$@"; then
    exec btm "$@"
  fi
  _native_dir="${ARGVUS_CONFIG_HOME}/bottom"
  if [ -e "$_native_dir" ] || [ -L "$_native_dir" ]; then
    XDG_CONFIG_HOME="$ARGVUS_CONFIG_HOME"
    export XDG_CONFIG_HOME
    exec btm "$@"
  fi
  exec btm --config_location "$(paths_config bottom/bottom.toml)" "$@"
}

run_spf() {
  source_bootstrap
  if has_arg '-c --config-file --config-file=* --hf --hotkey-file --hotkey-file=*' "$@"; then
    exec spf "$@"
  fi
  _native_dir="${ARGVUS_CONFIG_HOME}/superfile"
  if [ -e "$_native_dir" ] || [ -L "$_native_dir" ]; then
    XDG_CONFIG_HOME="$ARGVUS_CONFIG_HOME"
    export XDG_CONFIG_HOME
    exec spf "$@"
  fi
  _argvus_superfile_dir="$(paths_config superfile)"
  XDG_CONFIG_HOME="${_argvus_superfile_dir%/superfile}"
  export XDG_CONFIG_HOME
  exec spf "$@"
}

resolve_argvus_yazi_config() {
  for _dir in "$(paths_user_config yazi)" "$(paths_generated_config yazi)" "$(paths_system_config yazi)"; do
    if [ -e "$_dir" ] || [ -L "$_dir" ]; then
      printf '%s\n' "$_dir"
      return 0
    fi
  done
  paths_system_config yazi
}

read_active_theme() {
  _active_file="${ARGVUS_CONFIG_HOME}/argvus/.active-theme"
  if [ -f "$_active_file" ]; then
    sed -n '1p' "$_active_file"
  else
    printf 'argvus-dark-aether\n'
  fi
}

should_manage_btop_config() {
  _conf="$1"
  [ -f "$_conf" ] || return 0
  _theme="$(sed -n 's/^[[:space:]]*color_theme[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$_conf" | head -n1)"
  case "$_theme" in
    ''|Default|*argvus*) return 0 ;;
    *) return 1 ;;
  esac
}

materialize_argvus_btop_config() {
  _theme="$(read_active_theme)"
  _dst="$(paths_user_config btop)"
  _src="$(paths_system_config btop)"

  if [ ! -d "$_dst" ] && [ -d "$_src" ]; then
    mkdir -p "$_dst"
    cp -R "$_src/." "$_dst/"
  elif [ -d "$_src" ]; then
    mkdir -p "$_dst"
    if [ -f "$_src/btop.conf" ] && [ ! -e "$_dst/btop.conf" ]; then
      cp "$_src/btop.conf" "$_dst/btop.conf"
    fi
    if [ -d "$_src/themes/${_theme}" ]; then
      mkdir -p "$_dst/themes/${_theme}"
      cp -R "$_src/themes/${_theme}/." "$_dst/themes/${_theme}/"
    fi
  fi

  if [ -f "$_dst/btop.conf" ] && [ -f "$_dst/themes/${_theme}/theme.theme" ]; then
    sed -i "s|color_theme = .*|color_theme = \"${_dst}/themes/${_theme}/theme.theme\"|" "$_dst/btop.conf"
    printf '%s\n' "$_dst"
  else
    paths_config btop
  fi
}

materialize_argvus_yazi_config() {
  _theme="$(read_active_theme)"
  _dst="$(paths_user_config yazi)"
  _src="$(paths_system_config yazi)"

  if [ ! -d "$_dst" ] && [ -d "$_src" ]; then
    mkdir -p "$_dst"
    cp -R "$_src/." "$_dst/"
  elif [ -d "$_src" ]; then
    mkdir -p "$_dst"
    for _item in package.toml keymap.toml; do
      if [ -f "$_src/$_item" ] && [ ! -e "$_dst/$_item" ]; then
        cp "$_src/$_item" "$_dst/$_item"
      fi
    done
    if [ -d "$_src/flavors" ]; then
      mkdir -p "$_dst/flavors"
      for _flavor in "$_src"/flavors/*.yazi; do
        [ -d "$_flavor" ] || continue
        _flavor_dst="$_dst/flavors/${_flavor##*/}"
        [ -e "$_flavor_dst" ] || cp -R "$_flavor" "$_flavor_dst"
      done
    fi
    if [ -d "$_src/flavors/${_theme}.yazi" ]; then
      mkdir -p "$_dst/flavors/${_theme}.yazi"
      cp -R "$_src/flavors/${_theme}.yazi/." "$_dst/flavors/${_theme}.yazi/"
    fi
  fi

  if [ -f "$_dst/flavors/${_theme}.yazi/flavor.toml" ]; then
    printf '[flavor]\ndark = "%s"\n' "$_theme" > "$_dst/theme.toml"
    printf '%s\n' "$_dst"
  else
    resolve_argvus_yazi_config
  fi
}

run_yazi() {
  _requested_yazi_config="${YAZI_CONFIG_HOME:-}"
  source_bootstrap
  if [ -n "$_requested_yazi_config" ] && [ -d "$_requested_yazi_config" ]; then
    case "$_requested_yazi_config" in
      "${ARGVUS_CONFIG_HOME}/argvus/yazi"|/usr/share/argvus/yazi) ;;
      *) exec yazi "$@" ;;
    esac
  fi
  _native_dir="${ARGVUS_CONFIG_HOME}/yazi"
  if [ -e "$_native_dir" ] || [ -L "$_native_dir" ]; then
    _native_theme="$_native_dir/theme.toml"
    _native_flavor=""
    if [ -f "$_native_theme" ]; then
      _native_flavor="$(sed -n 's/^[[:space:]]*dark[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$_native_theme" | head -n1)"
    fi
    case "$_native_flavor" in
      argvus-*)
        if [ ! -f "$_native_dir/flavors/${_native_flavor}.yazi/flavor.toml" ]; then
          YAZI_CONFIG_HOME="$(materialize_argvus_yazi_config)"
          export YAZI_CONFIG_HOME
          exec yazi "$@"
        fi
        ;;
    esac
    YAZI_CONFIG_HOME="$_native_dir"
    export YAZI_CONFIG_HOME
    exec yazi "$@"
  fi
  YAZI_CONFIG_HOME="$(materialize_argvus_yazi_config)"
  export YAZI_CONFIG_HOME
  exec yazi "$@"
}

case "${1:-}" in
  --setup|setup)
    shift
    run_setup "$@"
    ;;
  --btop|btop)
    shift
    run_btop "$@"
    ;;
  --btm|btm|--bottom|bottom)
    shift
    run_btm "$@"
    ;;
  --spf|spf|--superfile|superfile)
    shift
    run_spf "$@"
    ;;
  --yazy|yazy|--yazi|yazi)
    shift
    run_yazi "$@"
    ;;
  --help|-h|'')
    usage
    ;;
  *)
    die "unknown command: $1"
    ;;
esac
