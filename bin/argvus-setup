#!/usr/bin/env sh
# Optional helper for copying packaged Argvus defaults into user config.

set -eu

CONFIG_SRC="${ARGVUS_CONFIG_SRC:-/usr/share/argvus}"
CONFIG_DST="${ARGVUS_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}/argvus"
dry_run=false
force=false
copy_all=false
copy_items=""

usage() {
  cat <<'EOF'
Usage:
  argvus-setup --copy <app> [--copy <app> ...] [--force] [--dry-run]
  argvus-setup --copy-all [--force] [--dry-run]
  argvus-setup --repair [--dry-run]

Argvus works without running this command. Packaged defaults are read from
/usr/share/argvus, and files under ~/.config/argvus override them.

Options:
  --copy <app>   Copy /usr/share/argvus/<app> to ~/.config/argvus/<app>.
  --copy-all     Copy all packaged defaults for explicit customization.
  --force        Replace an existing destination after backing it up.
  --repair       Backward-compatible alias for --copy argvus.
  --dry-run      Print actions without changing files.
  --help         Show this help.

Once copied, files are user-owned overrides and package upgrades no longer
replace them. The `argvus` app is merged into the root of ~/.config/argvus/,
its per-app siblings live under ~/.config/argvus/<app>/.
EOF
}

log() { printf '%s\n' "$*"; }
die() { printf 'argvus-setup: %s\n' "$*" >&2; exit 1; }

run() {
  if [ "$dry_run" = true ]; then
    printf '[dry-run] %s\n' "$*"
  else
    "$@"
  fi
}

append_copy_item() {
  item="$1"
  case "$item" in
    ''|.*|*/*) die "invalid app name: $item" ;;
  esac
  copy_items="${copy_items}${copy_items:+ }$item"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --copy)
      [ "$#" -ge 2 ] || die "--copy requires an app name."
      append_copy_item "$2"
      shift
      ;;
    --copy=*)
      append_copy_item "${1#--copy=}"
      ;;
    --copy-all)
      copy_all=true
      ;;
    --force)
      force=true
      ;;
    --repair)
      append_copy_item argvus
      ;;
    --dry-run)
      dry_run=true
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
  shift
done

[ -n "${HOME:-}" ] || die "HOME is not set."
[ -d "$CONFIG_SRC" ] || die "config source not found: $CONFIG_SRC"

if [ "$copy_all" = false ] && [ -z "$copy_items" ]; then
  usage
  exit 0
fi

if [ "$copy_all" = true ]; then
  copy_items=""
  for src_dir in "$CONFIG_SRC"/*; do
    [ -d "$src_dir" ] || continue
    copy_items="${copy_items}${copy_items:+ }${src_dir##*/}"
  done
fi

timestamp="$(date +%Y%m%d%H%M%S)"
run mkdir -p "$CONFIG_DST"

copy_app() {
  app="$1"
  src="$CONFIG_SRC/$app"

  [ -d "$src" ] || die "packaged config not found for app '$app': $src"

  # The `argvus` app holds user state/preferences and is merged into the root
  # of ~/.config/argvus/; sibling apps land in ~/.config/argvus/<app>/.
  if [ "$app" = "argvus" ]; then
    dst="$CONFIG_DST"
    copy_src="$src/."
  else
    dst="$CONFIG_DST/$app"
    copy_src="$src"
  fi

  if [ -e "$dst" ] || [ -L "$dst" ]; then
    if [ "$force" != true ]; then
      die "destination already exists: $dst
Use --force to replace it after a backup."
    fi

    backup="${dst}.bak-${timestamp}"
    suffix=1
    while [ -e "$backup" ] || [ -L "$backup" ]; do
      backup="${dst}.bak-${timestamp}-${suffix}"
      suffix=$((suffix + 1))
    done
    run mv "$dst" "$backup"
    log "Backup: $dst -> $backup"
  fi

  run mkdir -p "$(dirname "$dst")"
  run cp -R "$copy_src" "$dst"
  log "Copied: $src -> $dst"
}

for app in $copy_items; do
  copy_app "$app"
done

log "Done. Copied files are now user overrides."
