{
  "reload_style_on_change": true,
  "fixed-center": false,
  "position": "top",
  "mod": "dock",
  "margin-top": 0,
  "height": 28,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 3,

  "group/left1": {
    "orientation": "inherit",
    "modules": ["hyprland/workspaces"]
  },
  "group/left2": {
    "orientation": "inherit",
    "modules": ["mpris"]
  },
  "group/right-0": {
    "orientation": "inherit",
    "modules": ["clock#date", "clock#time"]
  },
  "group/right-1": {
    "orientation": "inherit",
    "spacing": 2,
    "modules": ["network",
      "hyprland/language",
      "power-profiles-daemon",
      "memory",
      "cpu",
      "custom/cpu-temp",
      "custom/gpu-temp"
    ]
  },
  "group/right-2": {
    "orientation": "inherit",
    "modules": [
      "custom/storage",
      "custom/recording",
      "pulseaudio#input",
      "pulseaudio#output"
    ]
  },
  "modules-left": ["group/left1", "group/left2"],
  "modules-center": ["custom/icon-window", "hyprland/submap", "hyprland/window"],
  "modules-right": [
    "tray",
    "group/right-2",
    "group/right-1",
    "group/right-0",
    "custom/power",
    "custom/settings"
  ],
  "custom/icon-window": {
    "format": " "
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
    "tooltip": false
  },
  "hyprland/submap": {
    "format": "[ {} ] ",
    "max-length": 20,
    "tooltip": false
  },
  "custom/window-or-mpris": {
    "exec": "/usr/share/argvus/waybar/scripts/window-or-mpris.sh",
    "interval": 1,
    "format": "{}",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "all-outputs": false,
    "disable-scroll": true,
    "sort-by-number": true,
    "tooltip": false,
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
  },
  "hyprland/language": {
    "format": "\uf11c {short}",
    // Search keyboard with command: hyprctl devices
    "keyboard-name": "usb-usb-keyboard",
    "on-click": "/usr/share/argvus/waybar/scripts/taskbar.sh --layout-keyboard"
  },
  "cpu": {
    "interval": 2,
    "format": "\uf2db {usage}%",
    "on-click": "/usr/share/argvus/waybar/scripts/taskbar.sh --cpu"
  },
  "custom/cpu-temp": {
    "exec": "/usr/share/argvus/waybar/scripts/sysinfo/cpu-temp.sh",
    "interval": 3,
    "format": " {}°C",
    "on-click": "/usr/share/argvus/waybar/scripts/taskbar.sh --cpu-temp"
  },
  "custom/gpu-temp": {
    "exec": "/usr/share/argvus/waybar/scripts/sysinfo/gpu.sh --temp",
    "interval": 5,
    "format": "󰾲 {}",
    "tooltip": false,
    "on-click": "/usr/share/argvus/waybar/scripts/taskbar.sh --gpu-temp"
  },
  "memory": {
    "interval": 2,
    "format": "\uf538 {percentage}%",
    "on-click": "/usr/share/argvus/waybar/scripts/taskbar.sh --mem"
  },
  "clock#date": {
    "format": "\uf073 {:L%a,%d %B}",
    "tooltip": false,
    // The built-in waybar calendar tooltip is disabled on purpose: the
    // Argvus calendar popup (argvus-calendar) is used instead.
    // "tooltip-format": "<span>{calendar}</span>",
    // "calendar": {
    //   "mode": "month",
    //   "weeks-pos": "right",
    //   "mode-mon-col": 3,
    //   "on-click-right": "mode",
    //   "format": {
    //     "month": "<span color='#ffead3'><b>{}</b></span>",
    //     "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
    //     "today": "<span color='#ff6699'><b>{}</b></span>"
    //   }
    // },
    "on-click": "/usr/lib/argvus-calendar/waybar-launcher --surface {x_root} {y_root}"
  },
  "clock#time": {
    "format": "\uf017 {:L%H:%M}",
    "tooltip": false
  },
  "network": {
    "format-icons": [
      "󰌙",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "\uf0ac",
    "format-disconnected": "\uf127",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "nospacing": 1,
    "on-click": "nm-connection-editor", // or: "kitty --title nmtui-float -e nmtui"
    "on-click-right": "/usr/share/argvus/waybar/scripts/netctl.sh"
  },
  "bluetooth": {
    "format": "{status}",
    "format-connected": "\uf294 {num_connected}",
    "format-off": "\uf294",
    "format-on": "\uf294",
    "format-no-controller": "",
    "tooltip-format": "{controller_alias}\t{controller_address}\n{num_connected} device(s) connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "on-click": "blueman-manager",
    "interval": 30
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
    "default": "\uf0e7",
    "performance": "\uf0e7",
    "balanced": "\uf24e",
    "power-saver": "\uf06c"
    }
  },
  "pulseaudio#input": {
    "format-source": "\uf130",
    "format-source-muted": "\uf131",
    "format": "{format_source}",
    "tooltip-format": "{format_source} {source_volume}%",
    "scroll-step": 1,
    "smooth-scrolling-threshold": 1,
    "max-volume": 100,
    "on-click": "pwvucontrol -t 3",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%+ -l 1.0",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%-"
  },
  "pulseaudio#output": {
    "format": "{icon}",
    "tooltip-format": "{icon}  {volume}%",
    "format-muted": "\uf6a9",
    "format-icons": {
      "default": [
        "\uf027",
        "\uf6a8",
        "\uf028"
      ]
    },
    "max-volume": 100,
    "scroll-step": 2,
    "smooth-scrolling-threshold": 1,
    "on-click": "pwvucontrol -t 4",
    "on-click-right": "pamixer -t",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
  },
  "custom/settings": {
      "exec": "[ \"$(cat ${XDG_CACHE_HOME:-$HOME/.cache}/argvus/waybar/sidebar-state 2>/dev/null)\" = 'open' ] && echo '\uf0c9' || echo '\uf00d'",
      "interval": 1,
      "format": "{}",
      "tooltip": false,
      "on-click": "/usr/share/argvus/waybar/scripts/taskbar.sh --sidebar-toggle"
  },
  "custom/recording": {
    "exec": "/usr/share/argvus/hypr/scripts/screenshot.sh --video-full-status",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "on-click": "/usr/share/argvus/hypr/scripts/screenshot.sh --video-full",
    "on-click-right": "/usr/share/argvus/hypr/scripts/screenshot.sh --video-full-stop"
  },
  // Removable storage (UDisks2). Compact Font Awesome icon near recording/sound;
  // left = choose device and open, right = full context menu.
  "custom/storage": {
    "exec": "argvus-storage watch",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "hide-empty-text": true,
    "on-click": "/usr/share/argvus/hypr/scripts/storage-menu.sh"
    // "on-click-right": "argvus-storage devices"
  },
  "tray": {
    "icon-size": 12,
    "spacing": 12,
    "show-passive-items": false
  },
  // paused: f144 play:
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "<span color='grey'>{status_icon} {dynamic}</span>",
    "max-length": 80,
    "interval": 1,
    "player-icons": {
      "default": "\uf28b",
      "mpv": "\uf001"
    },
    "status-icons": {
      "paused": "\uf144"
    },
    "ignored-players": ["firefox", "chromium", "brave"]
  },
  "custom/power": {
    "format": "\uf011",
    "tooltip": false,
    "on-click": "/usr/share/argvus/waybar/scripts/taskbar.sh --power-menu"
  }
}
