# Maintainer: William C. Canin
# Package base of the ARGVUS workspace. The Cargo workspace under this repository
# builds the `argvus` command and the GTK 4 helpers of `argvus-gtk`.
pkgbase=argvus
pkgname=('argvus' 'argvus-gtk' 'argvus-greeter')
pkgver=0.1.0
pkgrel=1
pkgdesc="ARGVUS desktop: command, data and shared Rust crates."
arch=('x86_64')
url="https://github.com/argvus/argvus"
license=('GPL-3.0-only')
makedepends=('cargo' 'pkgconf' 'gtk4' 'gtk4-layer-shell')
options=('!debug' '!lto')

depends=(
  'argvus-app-profiles'
  'argvus-firewall'
  'argvus-appearance'
  'argvus-branding'
  'argvus-control-panel'
  'argvus-display'
  'argvus-greeter'
  'argvus-icons'
  'argvus-lock'
  'argvus-notifications'
  'argvus-portal'
  'argvus-power'
  'argvus-session'
  'argvus-hyprland'
  'argvus-launcher'
  'argvus-accounts'
  'argvus-taskbar'
  'argvus-waybar'
  'hyprland'
  'hyprland-guiutils'
