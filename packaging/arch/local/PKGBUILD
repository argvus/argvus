)
sha256sums=('SKIP')

# shellcheck disable=SC1091
_functions_file="${startdir:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/../common/functions.sh"
. "$_functions_file"

prepare() {
  arch_normalize_source_tree
}

build() {
  arch_build_argvus_workspace
}

check() {
  arch_check_argvus_workspace
}

package_argvus() {
  pkgdesc="ARGVUS desktop: command, data and the Hyprland-facing runtime."
  depends=(
    'argvus-app-profiles'
    'argvus-firewall'
    'argvus-appearance'
    'argvus-branding'
    'argvus-control-panel'
    'argvus-display'
    'argvus-greeter'
    'argvus-icons'
    'argvus-lock'
    'argvus-notifications'
    'argvus-portal'
    'argvus-power'
    'argvus-session'
    'argvus-hyprland'
    'argvus-launcher'
    'argvus-accounts'
    'argvus-taskbar'
    'argvus-waybar'
    'hyprland'
    'hyprland-guiutils'
    'hyprland-qt-support'
    'hyprpolkitagent'
    'hyprshot'
    'wayland'
    'firefox'
    'code'
    'mesa'
    'mesa-utils'
    'qt5-quickcontrols2'
    'qt5ct'
    'qt6-tools'
    'virtualbox-guest-utils'
    'adwaita-icon-theme'
    'cliphist'
    'fastfetch'
    'gcc-libs'
    'okular'
    'feh'
    'glib2'
    'grim'
    'gsimplecal'
    'gtk4'
    'gtk-layer-shell'
    'imv'
    'audacious'
    'udisks2'
    'udiskie'
    'jq'
    'mpv'
    'nautilus'
    'noto-fonts'
    'noto-fonts-emoji'
    'satty'
    'slurp'
    'gpu-screen-recorder'
    'swaybg'
    'ttf-jetbrains-mono-nerd'
    'ttf-nerd-fonts-symbols-mono'
    'vivid'
    'wev'
    'mousepad'
    'wf-recorder'
    'wireplumber'
    'wl-clipboard'
    'wtype'
    'xdg-utils'
    'xarchiver'
    'neovim'
    'zathura'
    'zip'
    'zsh'
  )
  replaces=(
    'argvus-config'
    'argvus-i18n'
    'argvus-language-en-us'
    'argvus-language-pt-br'
    'argvus-keys'
    'argvus-projects'
    'argvus-terminal'
    'argvus-system-monitor'
    'argvus-network'
    'argvus-widget-telemetry'
  )
  conflicts=(
    'argvus-config'
    'argvus-i18n'
    'argvus-language-en-us'
    'argvus-language-pt-br'
    'argvus-keys'
    'argvus-projects'
    'argvus-terminal'
    'argvus-system-monitor'
    'argvus-network'
    'argvus-widget-telemetry'
  )
  provides=(
    'argvus-config'
    'argvus-i18n'
    'argvus-language-en-us'
    'argvus-language-pt-br'
    'argvus-keys'
    'argvus-projects'
    'argvus-terminal'
    'argvus-system-monitor'
    'argvus-network'
    'argvus-widget-telemetry'
  )
  arch_package_argvus
}

package_argvus-gtk() {
  pkgdesc="ARGVUS GTK 4 helpers: Control Center, taskbar calendar, removable devices and loading overlay."
  depends=(
    'argvus'
    'gtk4'
    'gtk4-layer-shell'
  )
  replaces=(
    'argvus-control-center'
    'argvus-taskbar-calendar'
    'argvus-loading-theme'
    'argvus-removable-devices'
  )
  conflicts=(
    'argvus-control-center'
    'argvus-taskbar-calendar'
    'argvus-loading-theme'
    'argvus-removable-devices'
  )
  provides=(
    'argvus-control-center'
    'argvus-taskbar-calendar'
    'argvus-loading-theme'
    'argvus-removable-devices'
  )
  arch_package_argvus_gtk
}

package_argvus-greeter() {
  pkgdesc="Keyboard-first TUI greetd greeter for the ARGVUS desktop."
  depends=(
    'greetd'
    'argvus'
    'argvus-app-profiles'
    'argvus-appearance'
    'argvus-session'
    'kitty'
    'hyprland'
    'systemd-libs'
    'libdrm'
  )
  backup=(
    'etc/argvus/greeter.toml'
    'etc/argvus/hyprland-argvus-greeter.conf'
    'etc/argvus/hyprland-argvus-greeter.lua'
  )
  install=argvus-greeter.install
  arch_package_argvus_greeter
}
