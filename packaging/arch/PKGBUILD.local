# Maintainer: William C. Canin
pkgname=argvus
pkgver=0.3.0
pkgrel=1
pkgdesc="Complete ARGVUS desktop environment metapackage."
arch=('any')
url="https://github.com/argvus/argvus"
license=('GPL-3.0-only')
options=('!debug')

depends=(
  'argvus-app-profiles'
  'argvus-appearance'
  'argvus-calendar'
  'argvus-display'
  'argvus-greeter'
  'argvus-lock'
  'argvus-network'
  'argvus-notifications'
  'argvus-portal'
  'argvus-power'
  'argvus-settings'
  'argvus-session'
  'argvus-shell'
	'argvus-accounts'
  'argvus-storage'
	'argvus-default-apps'
  'argvus-waybar'
	'argvus-pwvucontrol'
	'argvus-snappy-switcher'
	'hyprland'
  'hyprland-guiutils'
  'hyprland-qt-support'
  'hyprpolkitagent'
  'hyprshot'
	'wayland'
	'firefox'
	'mesa'
	'mesa-utils'
	'qt5-quickcontrols2'
  'qt5ct'
  'qt6-tools'
  'virtualbox-guest-utils'
  'adwaita-icon-theme'
  'cliphist'
  'fastfetch'
  'okular'
	'feh'
  'glib2'
  'grim'
  'gsimplecal'
  'gtk-layer-shell'
  'imv'
	'audacious'
  'udisks2'
  'udiskie'
  'jq'
  'mpv'
  'nautilus'
  'noto-fonts'
  'noto-fonts-emoji'
  'satty'
  'slurp'
	'gpu-screen-recorder'
  'swaybg'
  'ttf-jetbrains-mono-nerd'
  'ttf-nerd-fonts-symbols-mono'
  'vivid'
  'wev'
	'mousepad'
  'wf-recorder'
  'wireplumber'
  'wl-clipboard'
  'wtype'
  'xdg-utils'
  'xarchiver'
	'neovim'
  'zathura'
  'zip'
  'zsh'
)
optdepends=(
  'blueman: optional Bluetooth manager and tray applet'
  'kooha: graphical screen recording utility'
  'nwg-look: GTK theme configuration utility'
)
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=("SKIP")

package() {
  cd "${pkgname}-${pkgver}"

  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
