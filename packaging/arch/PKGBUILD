# Maintainer: William C. Canin
pkgname=argvus
pkgver=0.4.0
pkgrel=1
pkgdesc="Complete ARGVUS desktop environment package."
arch=('x86_64')
url="https://github.com/argvus/argvus"
license=('GPL-3.0-only')
options=('!debug')

depends=(
  'argvus-app-profiles'
  'argvus-appearance'
  'argvus-calendar'
  'argvus-display'
  'argvus-greeter'
  'argvus-icons'
  'argvus-lock'
  'argvus-network'
  'argvus-notifications'
  'argvus-portal'
  'argvus-power'
  'argvus-settings'
  'argvus-session'
  'argvus-shell'
	'argvus-accounts'
  'argvus-storage'
  'argvus-theme-nautilus'
	'argvus-default-apps'
  'argvus-waybar'
	'argvus-pwvucontrol'
	'argvus-snappy-switcher'
	'hyprland'
  'hyprland-guiutils'
  'hyprland-qt-support'
  'hyprpolkitagent'
  'hyprshot'
	'wayland'
	'firefox'
	'mesa'
	'mesa-utils'
	'qt5-quickcontrols2'
  'qt5ct'
  'qt6-tools'
  'virtualbox-guest-utils'
  'adwaita-icon-theme'
  'cliphist'
  'fastfetch'
  'gcc-libs'
  'okular'
	'feh'
  'glib2'
  'grim'
  'gsimplecal'
  'gtk4'
  'gtk-layer-shell'
  'imv'
	'audacious'
  'udisks2'
  'udiskie'
  'jq'
  'mpv'
  'nautilus'
  'noto-fonts'
  'noto-fonts-emoji'
  'satty'
  'slurp'
	'gpu-screen-recorder'
  'swaybg'
  'ttf-jetbrains-mono-nerd'
  'ttf-nerd-fonts-symbols-mono'
  'vivid'
  'wev'
	'mousepad'
  'wf-recorder'
  'wireplumber'
  'wl-clipboard'
  'wtype'
  'xdg-utils'
  'xarchiver'
	'neovim'
  'zathura'
  'zip'
	'zsh'
)
makedepends=(
  'cargo'
  'pkgconf'
)
optdepends=(
  'blueman: optional Bluetooth manager and tray applet'
  'kooha: graphical screen recording utility'
  'nwg-look: GTK theme configuration utility'
)
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
)
sha256sums=('SKIP')

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"
}

build() {
  cd "${pkgname}-${pkgver}"

  export CFLAGS="${CFLAGS/-flto=auto/}"
  export CXXFLAGS="${CXXFLAGS/-flto=auto/}"
  export FFLAGS="${FFLAGS/-flto=auto/}"
  export FCFLAGS="${FCFLAGS/-flto=auto/}"
  export LDFLAGS="${LDFLAGS/-flto=auto/}"

  cargo build --release --locked --target-dir target
}

check() {
  cd "${pkgname}-${pkgver}"

  export CFLAGS="${CFLAGS/-flto=auto/}"
  export CXXFLAGS="${CXXFLAGS/-flto=auto/}"
  export FFLAGS="${FFLAGS/-flto=auto/}"
  export FCFLAGS="${FCFLAGS/-flto=auto/}"
  export LDFLAGS="${LDFLAGS/-flto=auto/}"

  cargo test --locked --target-dir target
}

package() {
  cd "${pkgname}-${pkgver}"

  install -Dm755 "target/release/argvus-about" \
    "${pkgdir}/usr/bin/argvus-about"

  install -Dm644 usr/share/applications/argvus-about.desktop \
    "${pkgdir}/usr/share/applications/argvus-about.desktop"

  install -Dm644 assets/argvus-about.svg \
    "${pkgdir}/usr/share/argvus-about/argvus-about.svg"
  install -Dm644 assets/argvus-about.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/argvus-about.svg"

  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
