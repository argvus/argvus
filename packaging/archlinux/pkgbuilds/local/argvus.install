#!/usr/bin/env bash
# Hooks of the argvus package, which now carries the login greeter as well.
post_install() {
	local package_version="${1#*:}"
	package_version="${package_version%-*}"
	[ -n "$package_version" ] || package_version=unknown

	/usr/bin/systemd-tmpfiles --create /usr/lib/tmpfiles.d/argvus-greeter.conf >/dev/null 2>&1 || true
	/usr/lib/argvus/commands/greeter-setup --migrate-paths >/dev/null 2>&1 || true
	/usr/lib/argvus/commands/greeter-setup --sync-themes >/dev/null 2>&1 || true

	local cyan='\033[0;36m'
	local green='\033[0;32m'
	local reset='\033[0m'

	cat <<EOF
                                  #    #
                              #####    ####
                           #######  ##  #######
                       ##########  ####  ##########
                       #########  ######  #########
                     #     ####  ########  ####     #
                    ######      ##########      ######
                   ##########     ######     ##########
                  ###############        ###############
                ####################  ###################
                ####################  ####################
                 ###################  ##################
                     ###############  ###############
                        ############  ###########
                            ########  ########
                               #####  #####
                                   #  #

                   __    ____   ______     ___   _ ____
                  /  \  |  _ \ / ___\ \   / / | | / ___|
                 / /\ \ | |_) | |  _ \ \ / /| | | \___ \
                / /  \ \|  _ <| |_| | \ V / | |_| |___) |
               /_/    \_\_| \_\\____|  \_/   \___/|____/  v${package_version}

A modular desktop environment for Wayland and Arch Linux, built on Hyprland.

EOF

	printf '\n'
	printf '                          %bInstallation complete!%b\n' "$green" "$reset"
	printf '\n'
	printf 'NEXT STEPS\n'
	printf '──────────────────────────────────────────────\n'
	printf '\n'
	printf 'Enable Argvus Greeter with greetd:\n'
	printf '    %bsudo argvus greeter-setup --enable%b\n' "$cyan" "$reset"
	printf '\n'
	printf 'Enable and immediately restart greetd.service:\n'
	printf '    %bsudo argvus greeter-setup --now%b\n' "$cyan" "$reset"
	printf '\n'
	printf 'If you prefer to log in via TTY, use:\n'
	printf '    %bargvus --start-desktop%b\n' "$cyan" "$reset"
	printf '──────────────────────────────────────────────\n'
	printf '\n'
}

post_upgrade() {
	post_install "$1"
}
