// ARGVUS account administration.
//
// When `argvus-accounts manage` needs administrator authentication, the
// password asked is the caller's own when the caller is in an administrator
// group (`wheel`, Arch's sudoers and polkit default, or `sudo`), and the root
// password otherwise. Keep the groups in sync with ADMIN_GROUPS in
// argvus-accounts-core/src/admin.rs. The account being changed or deleted is
// never asked for a password.
polkit.addAdminRule(function (action, subject) {
  if (action.id !== "org.freedesktop.policykit.exec" ||
      action.lookup("program") !== "/usr/lib/argvus/commands/accounts") {
    return [];
  }
  if (subject.isInGroup("wheel") || subject.isInGroup("sudo")) {
    return ["unix-user:" + subject.user];
  }
  return ["unix-user:root"];
});
