[Unit]
Description=ARGVUS Clock in the background (keeps alarms active)
Documentation=https://github.com/argvus/argvus
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/argvus clock --background
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
